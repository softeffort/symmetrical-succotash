{
  "name": "Premier",
  "short_name": "Premier",
  "description": "AI assistant with its own computer: chat, code, sites and files",
  "id": "/chat",
  "start_url": "/chat?lang=en",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
