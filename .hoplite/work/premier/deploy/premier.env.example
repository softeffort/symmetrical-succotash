# Настройки Premier на сервере. Скопируйте в /etc/premier/premier.env и заполните.
# Файл читает только root и сервис — пароли и ключи не лежат в папке data/ и не попадают в бэкап.

# Пароль панели /panelp — от 12 символов. install.sh создаёт случайный.
# Если пусто или слишком простой — Premier сам создаст пароль и запишет его в /opt/premier/data/admin-password.txt
ADMIN_PASSWORD=

# Слушать только локально: снаружи сайт доступен только через Caddy/nginx (HTTPS)
HOST=127.0.0.1
PORT=3000

# Адрес сайта — для возврата после оплаты и входа через Google (без / в конце)
PUBLIC_URL=https://example.ru

# Адрес API для кабинета разработчика и скрипта подключения (без / в конце), лучше напрямую, мимо Cloudflare (у него лимит 120 с).
# Не задан — https://ide.kgpix.bond (как раньше). Пустое значение (API_BASE_URL=) — берётся PUBLIC_URL, а без него адрес из запроса.
API_BASE_URL=https://ide.kgpix.bond

# Заголовкам X-Real-IP / X-Forwarded-For верим только от прокси на этой же машине (127.0.0.1, ::1).
# Прокси в Docker или на другом сервере — перечислите через запятую IP или IPv4-подсети:
# TRUSTED_PROXIES=172.17.0.1,10.0.0.0/24
# TRUST_PROXY=0 — не верить заголовкам никогда; TRUST_PROXY=1 — верить всегда (только если сервис недоступен напрямую из интернета)

# Лимиты API (/v1): размер тела запроса, МБ (count_tokens — тот же), сколько МБ тел можно читать одновременно на весь сервер,
# запросов в минуту и параллельных запросов на одного пользователя. Держите API_BODY_MB не больше client_max_body_size прокси.
# API_BODY_MB=32
# API_BODY_INFLIGHT_MB=128
# Сколько МБ тел может загружать одновременно один пользователь (по умолчанию 2 × API_BODY_MB) и за сколько мс тело должно дойти
# API_BODY_INFLIGHT_USER_MB=64
# API_BODY_TIMEOUT_MS=60000
# API_RPM=60
# API_CONCURRENCY=10
# Всего параллельных запросов к API на весь сервер
# API_GLOBAL_CONCURRENCY=200
# Сколько секунд ждать следующий кусок ответа модели (тишина дольше — обрыв), и мс на запись ответа медленному клиенту
# MODEL_IDLE_TIMEOUT=180
# API_WRITE_TIMEOUT_MS=60000
# Доп. beta-возможности Anthropic, которые можно передавать провайдеру (префиксы через запятую; по умолчанию — thinking, caching, tool streaming)
# API_NATIVE_BETAS=

# Остановка сервиса (systemctl stop/restart): сколько мс ждать запросы к API в работе, по умолчанию 5000.
# Всё это время сайт не принимает новые соединения. Оборванные запросы возвращают плату полностью.
# SHUTDOWN_GRACE_MS=5000

# Ключи Platega (если заданы здесь — поля в панели блокируются)
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=

# Crypto Bot (@CryptoBot → Crypto Pay → My Apps → API Token). Можно не задавать здесь, а вписать в панели.
# CRYPTOPAY_TOKEN=
# CRYPTOPAY_TESTNET=1   # токен из @CryptoTestnetBot, для проверки без денег

# Вход через Google (console.cloud.google.com → Google Auth Platform → Clients).
# Redirect URI в Google: https://ВАШ-ДОМЕН/api/auth/google/callback
# Если поля пустые — кнопки «Войти через Google» нет.
GOOGLE_CLIENT_ID=1260644134-10l2percsm0emflbc33ocqethlfjrefd.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Вход через GitHub (github.com → Settings → Developer settings → OAuth Apps).
# Callback URL в GitHub: https://ВАШ-ДОМЕН/api/auth/github/callback
# Если поля пустые — кнопки «Продолжить с GitHub» нет.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Python в Docker. Rootless Docker пользователя premier (см. DEPLOY.md, шаг 6):
# DOCKER_HOST=unix:///run/user/ID_ПОЛЬЗОВАТЕЛЯ/docker.sock
# Выключить выполнение кода совсем:
# CODE_RUNNER=off

# Облачный компьютер — свой Linux у пользователей платных тарифов (тот же Docker, что для Python).
# Образ: docker build -t premier-cloud -f sandbox/cloud.Dockerfile sandbox
# Адрес для сайтов, запущенных в облачном компьютере; без него сайты не открываются. Нужна форма со звёздочкой:
# каждое открытие сайта получает свой случайный поддомен (нужны запись DNS *.pc.example.ru и сертификат на неё,
# см. Caddyfile / nginx.conf). Адрес без «*.» превью НЕ включает (этап 3, CLD-13).
# CLOUD_PREVIEW_URL=https://*.pc.example.ru
# Временно, если поддомены настроить нельзя (все сайты на одном адресе, защита зависит от браузера):
# CLOUD_PREVIEW_URL=https://pc.example.ru  и  CLOUD_PREVIEW_SINGLE=unsafe
# Пределы прокси превью на одного пользователя: CLOUD_PREVIEW_MAX_REQ=32 (запросов одновременно)
# CLOUD_PREVIEW_MAX_WS=16 (WebSocket) CLOUD_PREVIEW_HEAD_MS=60000 (ожидание ответа) CLOUD_PREVIEW_IDLE_MS=300000 (тишина в ответе)
# Без интернета в контейнерах:            CLOUD_NETWORK=none
# Выключить облачный компьютер:           CLOUD_RUNNER=off
# Выключить оплату через Robokassa (способ не предлагается, уведомления не принимаются): ROBOKASSA=off
# Лимиты: CLOUD_MEMORY=1g CLOUD_CPUS=1 CLOUD_MAX=10 (одновременно работающих) CLOUD_IDLE_MIN=20 CLOUD_MAX_MB=20480
# Сетевая защита контейнеров (этап 3): правила ставит scripts/cloud-firewall.sh (юнит и таймер premier-cloud-firewall),
# сервер читает отметку о них и без свежей отметки контейнеры не запускает. CLOUD_NETWORK=bridge больше не принимается.
# CLOUD_FIREWALL_STATE=/run/premier-cloud/firewall.json  — файл отметки (тот же путь должен быть у скрипта)
# CLOUD_FIREWALL_MAX_AGE=180       — сколько секунд отметка считается свежей
# CLOUD_FIREWALL_PROBE_SEC=300     — как часто сервер сам проверяет из контейнера, что адрес сервера закрыт
# CLOUD_FIREWALL_EXTRA_DROP=       — дополнительные закрытые сети через пробел (читает скрипт, задаётся в его окружении)
# Диск облачного компьютера: CLOUD_WATCH_SEC=20 (как часто измеряется занятое место) CLOUD_MIN_FREE_MB=2048 (меньше
# свободного на диске сервера — запись и запуск останавливаются) CLOUD_UPLOAD_BUDGET_MB=200 (загрузки, идущие одновременно)
# CLOUD_TRASH_MAX_MB=5120 (корзина удалённых проектов)
# Пределы одного ответа с инструментами: AGENT_MAX_ACTIONS=120 (действий) AGENT_MAX_SEC=1800 (секунд). Дальше — «Продолжить».
# Результаты Python (графики, таблицы): CODE_FILES_DAYS=30 (срок хранения, 0 — не удалять) CODE_FILES_MAX_MB=200
# (на пользователя, 0 — без предела) CODE_UNTAR_MS=15000 (предел времени разбора архива с результатами)
# Большие проекты в чате (облачный компьютер, свой компьютер, папка):
# AGENT_ROUNDS=40            — шагов с инструментами в одном ответе (5–200). Каждый шаг после первого списывает ещё одно сообщение.
#                              Шаги закончились — под ответом появляется кнопка «Продолжить».
# AGENT_CONTEXT_CHARS=240000 — сколько символов шагов держать в переписке с моделью; старые шаги сокращаются (файлы на диске не меняются).
# CLOUD_ZIP_MAX_MB=1024      — предел размера папки для кнопки «Скачать проект (ZIP)».

# Chromium: sandbox включён по умолчанию; запускайте сервис НЕ от root.
# При ошибке sandbox сначала проверьте настройки user namespaces / AppArmor ОС.
# Автоматического перехода в небезопасный режим нет.
# Только для браузера в отдельно изолированном окружении, с пониманием риска:
# BROWSER_NO_SANDBOX=1
# Системный Chromium, если браузер Puppeteer не установлен:
# CHROMIUM_PATH=/usr/bin/chromium
# Число одновременно открытых вкладок: 1–8, по умолчанию 2.
# BROWSER_PAGES=2

# Максимум одного запроса к текстовой модели, включая чтение потока.
# По умолчанию 180000 мс (3 минуты), диапазон 1000–600000.
# Автоматическое завершение HTML — максимум один дополнительный запрос.
# Это ограничивает ожидание, но не ускоряет саму модель.
# MODEL_REQUEST_TIMEOUT_MS=180000

# Оповещения об ошибках и падениях (мониторинг). Бот: @BotFather → токен; чат: напишите боту и откройте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates — там chat.id
# ALERT_TELEGRAM_TOKEN=
# ALERT_TELEGRAM_CHAT=
# или свой адрес, куда придёт POST {"text": "..."}:
# ALERT_WEBHOOK_URL=

# ---------- Рост: пробный период, скидка первой покупки, приглашения, «Поделиться», SEO ----------
# Всё необязательно: без этих строк работают значения по умолчанию (указаны ниже). 0/off — выключить.
# После правки: systemctl restart premier

# Пробный период «Pro на 3 дня за 99 ₽» — один раз на аккаунт и почту, только до первой оплаты. 0 — выключить
# TRIAL_OFFER=1
# TRIAL_PRICE=99
# TRIAL_DAYS=3
# TRIAL_PLAN=pro
# Пробный период каждого платного тарифа (Pro, Max, Ultra): по умолчанию 99 / 249 / 990 ₽ на 3 дня, один раз на тариф и человека.
# TRIAL_PLANS — какие тарифы (через запятую); TRIAL_PRICE_<ТАРИФ> и TRIAL_DAYS_<ТАРИФ> — цена и дни; значения из панели важнее.
# Пробный Ultra виден только при включённых кредитах Ultra, цена не ниже худшего расхода кредитов (дней+1) × кредитов × себестоимость.
# TRIAL_PLANS=pro,max,ultra
# TRIAL_PRICE_PRO=99
# TRIAL_PRICE_MAX=249
# TRIAL_PRICE_ULTRA=990
# TRIAL_DAYS_PRO=3
# TRIAL_DAYS_MAX=3
# TRIAL_DAYS_ULTRA=3
# Подпись карточки (английская версия — та же переменная с _EN, например TRIAL_BADGE_EN=Popular start)
# TRIAL_BADGE=Популярный старт

# Автоскидка на первую покупку, % (0 — выключить, максимум 90). Без промокода; с промокодом не суммируется — берётся выгоднее
# FIRST_DISCOUNT=30
# FIRST_DISCOUNT_PLANS=pro,max
# Скидка остаётся и после пробного периода за 99 ₽ (0 — пробный период «съедает» скидку)
# FIRST_DISCOUNT_AFTER_TRIAL=1

# «Пригласи друга»: обоим +REF_BONUS_DAYS дней тарифа REF_BONUS_PLAN после ПЕРВОЙ оплаты приглашённого
# REF_MODE=pay              # legacy — прежние правила (3 сообщения, ступени 10/25/50/100, +2 дня)
# REF_BONUS_DAYS=3
# REF_BONUS_PLAN=pro        # у кого Max — бонус днями Max
# REF_MAX=20                # не больше 20 бонусов на одного пригласившего (за всё время)
# REF_TRIAL_COUNTS=1        # пробный период за 99 ₽ считается первой оплатой (0 — ждать полной оплаты)
# REF_BIND_HOURS=72         # привязать приглашение можно в течение 72 ч после регистрации и только до первой оплаты
# REF_PAY_DAYS=365          # сколько дней ждём первую оплату приглашённого
# REF_SIGNUP_MSGS=0         # бонусные сообщения приглашённому сразу при привязке (0 — нет)
# REF_RATE_USER=10          # попыток привязки с аккаунта за 10 минут
# REF_RATE_IP=30            # попыток привязки с одного IP за час

# «Поделиться» чатом: ссылка /c/<код> только для чтения
# SHARE=1                   # 0 — выключить (все ссылки перестают открываться)
# SHARE_RATE=20             # созданий/обновлений ссылок в час на пользователя
# SHARE_MAX=200             # действующих ссылок на пользователя
# SHARE_INDEX=0             # 1 — разрешить поисковикам индексировать открытые чаты (по умолчанию noindex)
# SHARE_REF=0               # 1 — кнопка «Попробовать самому» ведёт по реферальной ссылке автора
# SHARE_CTA=Попробовать самому
# SHARE_TAGLINE=Premier — ИИ, у которого есть компьютер: пишет код, сам запускает его в облачном Linux и собирает готовые сайты и игры прямо в чате.

# Лимиты Free: мягкое предупреждение, когда осталось не больше N% дневных сообщений (0 — не показывать)
# FREE_WARN_PCT=20
# FREE_WARN_TEXT=Бесплатные сообщения почти закончились. Pro снимает лимиты

# SEO главной (title и description; для английской версии — SEO_TITLE_EN, SEO_DESCRIPTION_EN).
# Важно: PUBLIC_URL выше — из него строятся canonical, og:url, og:image и sitemap.xml
# SEO_TITLE=Premier — ИИ, у которого есть компьютер
# SEO_DESCRIPTION=ИИ, который не только отвечает, но и сам запускает код в облачном Linux: GPT, Gemini, DeepSeek, Kimi и Qwen в одном чате. Сайты, игры и Python без VPN и зарубежной карты. Начните бесплатно.

# Файлы проекта (база знаний): сколько символов из файлов проекта уходит в каждый запрос
# (всего, по умолчанию 300000, минимум 10000)
# PROJECT_FILES_MAX=300000

# PWA и push-уведомления (ИЗМЕНЕНИЯ-PWA-PUSH.txt). Ключи создаются сами и хранятся в базе.
# VAPID_SUBJECT=mailto:support@eide.pro
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# PUSH_OFF=1               # выключить уведомления
# PUSH_REMIND_MS=3600000   # как часто искать тарифы, которые заканчиваются завтра

# Командный тариф (ИЗМЕНЕНИЯ-КОМАНДНЫЙ-ТАРИФ.txt): новых переменных нет.
# Цена места, минимум и максимум мест — в Панели, раздел «Командный тариф».

# ---------- Надёжность чата (ИЗМЕНЕНИЯ-НАДЁЖНОСТЬ-ЧАТА.txt) ----------
# Максимальный размер запроса в чат, МБ — держите равным client_max_body_size (nginx) / max_size (Caddy)
#CHAT_BODY_MB=45
# Сколько ответов один пользователь может получать одновременно
#CHAT_MAX_PARALLEL=3
# Сколько последних сообщений с картинками отправлять модели (старые заменяются пометкой)
#CHAT_KEEP_IMAGES=4
# Таймауты модели в чате, мс: начало ответа / тишина в потоке / весь ответ
#MODEL_FIRST_BYTE_MS=120000
#MODEL_IDLE_MS=120000
#MODEL_REQUEST_TIMEOUT_MS=900000

# ---------- Ответ не теряется, файлы из ответа (ИЗМЕНЕНИЯ-ОТВЕТ-ФАЙЛЫ-ГОЛОС.txt) ----------
# Сколько минут ответ готовится дальше, когда человек закрыл страницу или потерял связь (1–720)
#CHAT_ORPHAN_MIN=60
# Сколько часов готовый ответ хранится на диске (data/gens), чтобы его можно было дочитать после возвращения (1–720)
#CHAT_GEN_KEEP_HOURS=24
